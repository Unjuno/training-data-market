# Generate each secret yourself. NEVER commit actual values.
TDM_COOKIE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
TDM_ADMIN_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
# Set true only for HTTPS sessions; for local HTTP leave false.
TDM_COOKIE_SECURE=false
# Must remain false until you independently verify public image rights.
TDM_PUBLISH_IMAGES=false
TDM_DATA_ROOT=./data
TDM_STATE_ROOT=./state

# Persisted voting deadline (seconds; 10..604800). Default: 86400.
TDM_ROUND_SECONDS=86400
# Only after rights verification: manifest.image_rights_status must also be APPROVED.
# TDM_PUBLISH_IMAGES=false
# TDM_DEMO_MODE=false
